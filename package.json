{
  "name": "tailwind-motion-native",
  "version": "0.2.0",
  "description": "tailwindcss-motion animation classes for Expo + Nativewind, played through Reanimated",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "tailwindcss-motion",
    "nativewind",
    "expo",
    "react-native",
    "reanimated",
    "moti",
    "animation",
    "motion"
  ],
  "homepage": "https://github.com/smarcombes/tailwind-motion-native#readme",
  "bugs": {
    "url": "https://github.com/smarcombes/tailwind-motion-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smarcombes/tailwind-motion-native.git"
  },
  "license": "MIT",
  "author": "Severin Marcombes",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/typescript/module/index.d.ts",
        "default": "./dist/module/index.js"
      },
      "require": {
        "types": "./dist/typescript/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/typescript/module/core/index.d.ts",
        "default": "./dist/module/core/index.js"
      },
      "require": {
        "types": "./dist/typescript/commonjs/core/index.d.ts",
        "default": "./dist/commonjs/core/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "!**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:unit && npm run test:native",
    "demo": "node scripts/print-classes.mjs",
    "vendor:upstream": "node scripts/vendor-upstream.mjs",
    "example:install": "node scripts/pack-for-example.mjs",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test",
    "prepare": "bob build",
    "test:unit": "node --test test/*.test.mjs",
    "test:native": "jest && jest --config jest.config.android.cjs",
    "probe:nativewind": "jest --testMatch \"<rootDir>/test/**/*.probe.tsx\"",
    "test:native:android": "jest --config jest.config.android.cjs"
  },
  "peerDependencies": {
    "nativewind": ">=4.1.0",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-reanimated": ">=3.16.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.81.4",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/react-native": "13.3.3",
    "@types/react": "^19.0.0",
    "jest": "^29.7.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-builder-bob": "^0.40.13",
    "react-native-reanimated": "^3.19.1",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-motion": "^1.1.1",
    "typescript": "^5.9.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
